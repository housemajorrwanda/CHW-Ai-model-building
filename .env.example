# Copy to .env and set values for deployment
# cp .env.example .env

# Backend
SECRET_KEY=your-secret-key-min-32-chars-for-production
DATABASE_URL=sqlite:///./easygrade.db
# For PostgreSQL: postgresql://user:password@host:5432/dbname

# Comma-separated origins that may call the API (browser origin).
# For boss/same-network access add your machine's IP, e.g. http://192.168.1.83
# Local Vite dev server (port 8080) is always merged in by the backend even if omitted here.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# Ports (optional; defaults in docker-compose)
# BACKEND_PORT=8000
# FRONTEND_PORT=80

# ─────────────────────────────────────────────────────────────────────────────
# Handwriting OCR
#
# DEFAULT — free, local, no API key:
#   The backend auto-enables a local handwriting ensemble whenever `torch` +
#   `transformers` are importable (already in the dev venv):
#     • microsoft/trocr-small-handwritten   English prose (~61M, fast on CPU)
#     • fhswf/TrOCR_Math_handwritten        handwritten formulas → LaTeX
#   First call downloads weights to the Hugging Face cache (~80MB + ~330MB),
#   afterwards they are reused. To disable entirely set:
# USE_TROCR=0
#
# Swap the prose model to the slower-but-stronger base variant on machines
# with more CPU/RAM budget:
# TROCR_PROSE_MODEL=microsoft/trocr-base-handwritten
#
# Optional: pix2tex (LaTeX-OCR) as a third pass (slow on CPU). Uncomment to enable:
USE_PIX2TEX=1
#
# Submission-time OCR runs fhswf math TrOCR on every line by default (ensemble
# with prose). On very slow hosts set:
# OCR_MATH_HEURISTIC_ONLY=1
#
# Preview PDF answer routing: max TrOCR lines scanned per page (default 18).
# TROCR_PREVIEW_MAX_LINES=20
#
# Preview: max math TrOCR (fhswf) forward-passes per page — equation lines (default 12).
# PREVIEW_MATH_TR=14
#
# OPTIONAL — local EasyOCR fallback (also free, smaller scope than TrOCR):
# USE_EASYOCR=1
#
# OPTIONAL — paid cloud providers (only if you want Mathpix-level math
# recognition; the system works fine without any of these):
#
# 1) Mathpix — best for handwritten math (A', B-bar, equations, ∑ m(0,1,4)…):
#    Sign up at https://mathpix.com → API keys, then:
# MATH_OCR_PROVIDER=mathpix
# MATHPIX_APP_ID=your_app_id
# MATHPIX_APP_KEY=your_app_key
#
# 2) Google Cloud Vision — strong general handwriting (English prose, numbered work):
#    Enable the Vision API and create an API key:
# MATH_OCR_PROVIDER=gcv
# GOOGLE_VISION_API_KEY=your_api_key
#
# 3) Azure AI Vision (Read API) — also reads handwriting well:
# MATH_OCR_PROVIDER=azure
# AZURE_VISION_KEY=your_subscription_key
# AZURE_VISION_ENDPOINT=https://<region>.api.cognitive.microsoft.com
#
# MATH_OCR_PROVIDER=auto picks the first provider whose credentials are set.
