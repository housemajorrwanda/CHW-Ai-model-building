SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./easygrade.db
# Render: use Internal Database URL from Postgres dashboard

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1
# Production: https://your-frontend.onrender.com

# Optional OCR (defaults work locally with Tesseract)
# USE_EASYOCR=1
# USE_PIX2TEX=1
# USE_TROCR=0

# Cloud OCR (pick one provider)
# MATH_OCR_PROVIDER=mathpix
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# MATH_OCR_PROVIDER=gcv
# GOOGLE_VISION_API_KEY=
# MATH_OCR_PROVIDER=azure
# AZURE_VISION_KEY=
